{
    // 僅檢查型別，不輸出 JavaScript；實際執行由 tsx 處理。
    "compilerOptions": {
        // 與 Node 24 的語言能力配合，並啟用 DOM 型別供瀏覽器回呼使用。
        "target": "ES2023",
        // 採用 Node 原生 ESM 規則，因此 TypeScript 內部匯入也使用 .js 副檔名。
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "types": ["node"],
        // 嚴格檢查空值、陣列索引與選用欄位，讓來源資料缺漏在開發時就能被發現。
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "noEmit": true
    },
    // 正式程式與測試都納入型別檢查。
    "include": ["src", "tests"]
}
