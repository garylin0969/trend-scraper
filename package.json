{
    "name": "trend-scraper",
    "version": "3.0.0",
    "private": true,
    "type": "module",
    "description": "Scheduled trend collectors with stable public JSON feeds",
    "license": "ISC",
    "engines": {
        "node": ">=24 <27"
    },
    "packageManager": "pnpm@12.16.1",
    "scripts": {
        "scrape": "tsx src/cli.ts",
        "scrape:bbc": "tsx src/cli.ts bbc",
        "scrape:google": "tsx src/cli.ts google",
        "scrape:ptt": "tsx src/cli.ts ptt",
        "scrape:komica": "tsx src/cli.ts komica",
        "typecheck": "tsc --noEmit",
        "test": "tsx --test tests/*.test.ts",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "pnpm typecheck && pnpm test && pnpm format:check"
    },
    "dependencies": {
        "cheerio": "1.2.0",
        "playwright": "1.64.1",
        "rss-parser": "3.13.0",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "prettier": "3.9.10",
        "tsx": "4.23.15",
        "typescript": "7.0.2"
    }
}
